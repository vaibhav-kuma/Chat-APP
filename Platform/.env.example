# PostgreSQL
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_password
POSTGRES_DB=platform

# App
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://platform:platform_dev_password@localhost:5433/platform
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change_me_to_a_long_random_string
SESSION_TTL_SECONDS=604800
# Set "true" to force Secure session cookies (required when serving over https).
# Defaults to on when PUBLIC_URL begins with https://.
SESSION_COOKIE_SECURE=
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:4000

# Razorpay (test keys) — fill these in to enable payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret_change_in_prod
# Admin-configured monthly plan
RAZORPAY_PLAN_ID=
DEFAULT_PLAN_PRICE_PAISE=99900
DEFAULT_PLAN_TRIAL_DAYS=7
GRACE_PERIOD_DAYS=3
MAX_FAILED_PAYMENTS=3

# Mux — fill these in to enable real video/streaming (leave empty in dev)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# Email (SMTP or Resend)
EMAIL_FROM=no-reply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
RESEND_API_KEY=

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin

# Grievance officer (placeholder)
GRIEVANCE_OFFICER_NAME=Grievance Officer
GRIEVANCE_OFFICER_EMAIL=grievance@example.com
